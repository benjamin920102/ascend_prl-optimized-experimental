#include "aicpu_api.h"
#include "a_prep/args.h"
#include "a_prep/blake3_parallel.h"
static uint64_t splitmix(uint64_t &x){uint64_t z=(x+=0x9e3779b97f4a7c15ULL);z=(z^(z>>30))*0xbf58476d1ce4e5b9ULL;z=(z^(z>>27))*0x94d049bb133111ebULL;return z^(z>>31);}
static uint64_t rot(uint64_t x,int k){return x<<k|x>>(64-k);}
static uint64_t next(uint64_t *s){uint64_t r=rot(s[1]*5,7)*9,t=s[1]<<17;s[2]^=s[0];s[3]^=s[1];s[1]^=s[2];s[0]^=s[3];s[2]^=t;s[3]=rot(s[3],45);return r;}
static void draw(uint32_t i,const uint8_t *key,int slot,uint8_t *d){
 uint8_t msg[64]={};uint32_t v=i+1;for(int j=0;j<4;j++)msg[slot*4+j]=(uint8_t)(v>>(8*j));
 memcpy(msg+32,"A_tensor",8);pearl_b3::hash(msg,64,key,d);
}
static void fill_range(void *arg,size_t lo,size_t hi){
 const PearlPrepArgs &p=*(const PearlPrepArgs*)arg;const uint64_t total=p.m*p.k;
 if(p.random_fill){
  // Partition by the ORIGINAL PRL_PREP_THREADS, regardless of team size.
  // Each PRNG stream retains its original seed, boundaries, and byte order.
  for(size_t t=lo;t<hi;t++){
   uint64_t x=p.seed+0x9e37ULL*(t+1),s[4];for(int j=0;j<4;j++)s[j]=splitmix(x);
   uint64_t i=total*t/p.threads,end=total*(t+1)/p.threads;
   while(i<end){uint64_t v=next(s);for(int j=0;j<8 && i<end;j++,v>>=8)p.a[i++]=(int8_t)((uint8_t)v%127)-63;}
  }
 }else{
  uint64_t begin=lo*1024,end=hi*1024;if(end>total)end=total;
  memset(p.a+begin,0,end-begin);
 }
}
static void eal_range(void *arg,size_t lo,size_t hi){
 const PearlPrepArgs &p=*(const PearlPrepArgs*)arg;
 for(size_t i=lo;i<hi;i++){uint8_t d[32];draw((uint32_t)i,p.roots+32,0,d);for(unsigned j=0;j<32 && i*32+j<p.m*p.rank;j++)p.eal[i*32+j]=(int8_t)((d[j]&63)-32);}
}
static void index_range(void *arg,size_t lo,size_t hi){
 const PearlPrepArgs &p=*(const PearlPrepArgs*)arg;
 for(size_t i=lo;i<hi;i++){uint8_t d[32];draw((uint32_t)i,p.roots+32,1,d);for(unsigned j=0;j<8 && i*8+j<p.k;j++){uint32_t u=pearl_b3::load(d+4*j),f=u&(p.rank-1);p.first[i*8+j]=(uint16_t)f;p.second[i*8+j]=(uint16_t)(f^(1u+(uint32_t)(((uint64_t)(p.rank-1)*u)>>32)));}}
}
// Each worker owns complete rows. EAL for a row remains cache-local;
// A/An accesses are contiguous. No byte-at-a-time AI Core GM loads.
static void an_range(void *arg,size_t lo,size_t hi){
 const PearlPrepArgs &p=*(const PearlPrepArgs*)arg;
 for(size_t row=lo;row<hi;row++){
  const int8_t *a=p.a+row*p.k,*e=p.eal+row*p.rank;
  int8_t *an=p.an+row*p.k;
  for(size_t col=0;col<p.k;col++){
   int v=(int)a[col]+(int)e[p.first[col]]-(int)e[p.second[col]];
   // Explicit modulo 256, followed by signed interpretation.
   unsigned u=(unsigned)v&255u;
   an[col]=(int8_t)(u<128u?(int)u:(int)u-256);
  }
 }
}
__global__ __aicpu__ uint32_t pearl_prep_a(void *arg){
 const PearlPrepArgs &p=*(const PearlPrepArgs*)arg;const uint64_t total=p.m*p.k;
 PearlTeam team(p.worker_threads);
 team.run(p.random_fill?p.threads:(total+1023)/1024,fill_range,arg);
 if(!p.random_fill)for(int i=0;i<8;i++)p.a[i]=(int8_t)(p.seed>>(8*i));
 pearl_b3::hash_parallel((const uint8_t*)p.a,total,p.key,p.roots,team);
 static const uint8_t salt[32]={0x82,0x49,0x40,0x6c,0xa0,0xed,0x15,0x16,0x96,0x16,0xf6,0x92,0xfc,0xf0,0x76,0xf8,0x92,0xdb,0xdb,0x2a,0x70,0x23,0xb8,0x52,0xf0,0xd4,0x77,0x19,0xc3,0x90,0x01,0x7b};
 uint8_t salted[32],msg[64]={};memcpy(salted,p.roots,32);
 if(p.cert>=3){memcpy(msg,p.roots,32);for(int j=0;j<4;j++)msg[32+j]=(uint8_t)(p.m>>(8*j));pearl_b3::hash(msg,64,salt,salted);}
 memcpy(msg,p.commit_b,32);memcpy(msg+32,salted,32);pearl_b3::hash(msg,64,nullptr,p.roots+32);
 team.run((p.m*p.rank+31)/32,eal_range,arg);
 team.run((p.k+7)/8,index_range,arg);
 if(p.make_an)team.run(p.m,an_range,arg);
 uint32_t actual=team.workers();memcpy(p.roots+64,&actual,sizeof(actual));
#ifndef PEARL_PREP_HOST_TEST
 // Join/barriers make worker writes visible to the caller; publish to AI Core.
 AscendC::DataStoreBarrier();
 if(p.profile)AscendC::printf("[aicpu] workers=%u requested=%u\n",team.workers(),p.worker_threads);
#endif
 return 0;
}
