#include "acl/acl.h"
#include <stdint.h>
#include <signal.h>
#include <stdio.h>
#include <stdlib.h>
#include <vector>

struct BenchArgs { uint32_t groups; uint32_t seed; uint32_t mode; uint32_t report; };
extern __global__ __aicpu__ uint32_t blake3_bench(void *args);
static volatile sig_atomic_t stopping=0;
static void sigint_handler(int) { stopping=1; }
static unsigned parse(const char *s,unsigned min,unsigned max,const char *key) {
    char *end=nullptr; unsigned long n=strtoul(s,&end,10);
    if (!s[0] || *end || n<min || n>max) {fprintf(stderr,"Invalid %s: %s (allowed %u..%u)\n",key,s,min,max);exit(2);}
    return (unsigned)n;
}
int main(int argc,char **argv) {
    const unsigned count=argc>1?parse(argv[1],1,32,"streams"):6;
    const unsigned groups=argc>2?parse(argv[2],1,1000000,"groups"):1024;
    const unsigned device=argc>3?parse(argv[3],0,255,"device"):0;
    signal(SIGINT,sigint_handler);
    aclError err=aclInit(nullptr);
    if(err!=ACL_SUCCESS) {fprintf(stderr,"aclInit: %d\n",(int)err);return 1;}
    err=aclrtSetDevice(device);
    if(err!=ACL_SUCCESS) {fprintf(stderr,"aclrtSetDevice: %d\n",(int)err);aclFinalize();return 1;}
    int status=0;
    std::vector<aclrtStream> streams(count,nullptr);
    unsigned created=0;
    for(;created<count;++created) {
        err=aclrtCreateStream(&streams[created]);
        if(err!=ACL_SUCCESS) {fprintf(stderr,"aclrtCreateStream: %d\n",(int)err);status=1;break;}
    }
    if(!status) {
        printf("BLAKE3 AICPU: 4 lanes x %u groups per kernel, %u streams, device %u\n",groups,count,device);
        printf("Each digest hashes a standalone 64-byte message. Ctrl+C stops after current wave.\n");fflush(stdout);
        BenchArgs self={1,0,1,0};
        blake3_bench<<<1,nullptr,streams[0]>>>(&self,sizeof(self));
        err=aclrtSynchronizeStream(streams[0]);
        if(err!=ACL_SUCCESS) {fprintf(stderr,"Self-test sync: %d\n",(int)err);status=1;}
        unsigned long long waves=0;
        while(!status && !stopping) {
            unsigned submitted=0;
            for(unsigned i=0;i<count && !stopping;++i) {
                BenchArgs args={groups,(uint32_t)((waves*count+i)*groups*4ull),0,(uint32_t)((waves%256==0) && i==0)};
                blake3_bench<<<1,nullptr,streams[i]>>>(&args,sizeof(args));
                ++submitted;
            }
            for(unsigned i=0;i<submitted;++i) {
                err=aclrtSynchronizeStream(streams[i]);
                if(err!=ACL_SUCCESS) {fprintf(stderr,"sync stream %u failed: %d\n",i,(int)err);status=1;}
            }
            if(!status && submitted==count) {
                ++waves;
                if(waves%64==0) {
                    const double n=(double)waves*count*groups*4;
                    printf("waves=%llu, BLAKE3 hashes=%.3f million, data=%.3f GiB (not throughput)\n",
                        waves,n/1e6,n*64.0/1073741824.0);fflush(stdout);
                }
            }
        }
        printf("Stopped; complete waves=%llu\n",waves);
    }
    for(unsigned i=0;i<created;++i) if(aclrtDestroyStream(streams[i])!=ACL_SUCCESS) status=1;
    if(aclrtResetDevice(device)!=ACL_SUCCESS) status=1;
    if(aclFinalize()!=ACL_SUCCESS) status=1;
    return status;
}
